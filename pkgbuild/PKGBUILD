pkgname=omascan
pkgver=0.1.3
pkgrel=1
pkgdesc='Scan paper to PDF from a SANE scanner'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-svg' 'qt6-wayland' 'xdg-desktop-portal' 'sane' 'sane-airscan')
optdepends=('ipp-usb: driverless scanners connected over USB')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/omascan "$pkgdir/usr/bin/omascan"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/omascan.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/omascan.svg"
  install -Dm644 "$startdir/omascan.desktop" "$pkgdir/usr/share/applications/omascan.desktop"
}
